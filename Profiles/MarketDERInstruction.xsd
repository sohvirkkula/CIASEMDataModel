   </xs:annotation>
   <xs:annotation>
      <xs:documentation/>
   </xs:annotation>
   <xs:element name="Profile" type="m:Profile"/>
   <xs:complexType name="Profile">
      <xs:sequence>
         <xs:element name="DistributedResourceActualEvent"
                     type="m:DistributedResourceActualEvent"
                     minOccurs="0"
                     maxOccurs="unbounded"/>
         <xs:element name="InstructionClearing"
                     type="m:InstructionClearing"
                     minOccurs="1"
                     maxOccurs="unbounded"/>
         <xs:element name="MarketRun"
                     type="m:MarketRun"
                     minOccurs="0"
                     maxOccurs="unbounded"/>
      </xs:sequence>
   </xs:complexType>
   <xs:simpleType name="AutomaticDispInstTypeCommitment"
                  sawsdl:modelReference="http://iec.ch/TC57/CIM100#AutomaticDispInstTypeCommitment">
      <xs:annotation>
         <xs:documentation>Commitment instruction types.</xs:documentation>
      </xs:annotation>
      <xs:restriction base="xs:string">
         <xs:enumeration value="DR_ADJUSTMENT">
            <xs:annotation>
               <xs:documentation>Distributed Resource adjustment for a distributed resource that is already deployed (committed).</xs:documentation>
            </xs:annotation>
         </xs:enumeration>
         <xs:enumeration value="DR_DEPLOY">
            <xs:annotation>
               <xs:documentation>Distributed Resource Deployment</xs:documentation>
            </xs:annotation>
         </xs:enumeration>
         <xs:enumeration value="DR_RELEASE">
            <xs:annotation>
               <xs:documentation>Distributed Resource Release</xs:documentation>
            </xs:annotation>
         </xs:enumeration>
         <xs:enumeration value="SHUT_DOWN">
            <xs:annotation>
               <xs:documentation>Shut down instruction type</xs:documentation>
            </xs:annotation>
         </xs:enumeration>
         <xs:enumeration value="START_UP">
            <xs:annotation>
               <xs:documentation>Start up instruction type</xs:documentation>
            </xs:annotation>
         </xs:enumeration>
      </xs:restriction>
   </xs:simpleType>
   <xs:complexType name="DistributedResourceActualEvent"
                   sawsdl:modelReference="http://iec.ch/TC57/CIM100#DistributedResourceActualEvent">
      <xs:annotation>
         <xs:documentation>A demand response event is created when there is a need to call upon resources to respond to demand adjustment requests. These events are created by ISO/RTO system operations and managed  by a demand response management system (DRMS). These events may or may not be coordinated with the Market Events and a defined Energy Market. The event will call for the deployment of a number of registered resources, or for deployment of resources within a zone (an organizational area within the power system that contains a number of resources).</xs:documentation>
      </xs:annotation>
      <xs:complexContent>
         <xs:extension base="m:MarketActualEvent">
            <xs:sequence/>
         </xs:extension>
      </xs:complexContent>
   </xs:complexType>
   <xs:complexType name="Document"
                   sawsdl:modelReference="http://iec.ch/TC57/CIM100#Document">
      <xs:annotation>
         <xs:documentation>Parent class for different groupings of information collected and managed as a part of a business process. It will frequently contain references to other objects, such as assets, people and power system resources.</xs:documentation>
      </xs:annotation>
      <xs:complexContent>
         <xs:extension base="m:IdentifiedObject">
            <xs:sequence/>
         </xs:extension>
      </xs:complexContent>
   </xs:complexType>
   <xs:complexType name="IdentifiedObject"
                   sawsdl:modelReference="http://iec.ch/TC57/CIM100#IdentifiedObject">
      <xs:annotation>
         <xs:documentation>This is a root class to provide common identification for all classes needing identification and naming attributes.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="mRID"
                     minOccurs="0"
                     maxOccurs="1"
                     type="xs:string"
                     sawsdl:modelReference="http://iec.ch/TC57/CIM100#IdentifiedObject.mRID">
            <xs:annotation>
               <xs:documentation>Master resource identifier issued by a model authority. The mRID is unique within an exchange context. Global uniqueness is easily achieved by using a UUID, as specified in RFC 4122, for the mRID. The use of UUID is strongly recommended.</xs:documentation>
               <xs:documentation>For CIMXML data files in RDF syntax conforming to IEC 61970-552, the mRID is mapped to rdf:ID or rdf:about attributes that identify CIM object elements.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="InstructionClearing"
                   sawsdl:modelReference="http://iec.ch/TC57/CIM100#InstructionClearing">
      <xs:annotation>
         <xs:documentation>Model of market clearing, relating to commitment instructions. Identifies interval.</xs:documentation>
      </xs:annotation>
      <xs:complexContent>
         <xs:extension base="m:MarketFactors">
            <xs:sequence>
               <xs:element name="ActualDemandResponseEvent"
                           minOccurs="0"
                           maxOccurs="1"
                           type="m:DistributedResourceActualEvent"
                           sawsdl:modelReference="http://iec.ch/TC57/CIM100#InstructionClearing.ActualDemandResponseEvent">
                  <xs:annotation>
                     <xs:documentation>ActualDemandResponseEvents may exist that are not part of a cordinated MarketActualEvent associated to a Market. These ActualDemandResponseEvents can have many InstructionClearing Instructions for specified RegisteredResources or Distributed Energy Resource type of AggregateNodes.</xs:documentation>
                  </xs:annotation>
               </xs:element>
            </xs:sequence>
         </xs:extension>
      </xs:complexContent>
   </xs:complexType>
   <xs:complexType name="Instructions"
                   sawsdl:modelReference="http://iec.ch/TC57/CIM100#Instructions">
      <xs:annotation>
         <xs:documentation>Provides the necessary information (on a resource basis) to capture the Startup/Shutdown instruction results. This information is relevant to the DA Market (RUC only) as well as the RT Market (HASP, Pre-dispatch, and Interval).</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="bindingDOT"
                     minOccurs="0"
                     maxOccurs="1"
                     type="xs:float"
                     sawsdl:modelReference="http://iec.ch/TC57/CIM100#Instructions.bindingDOT">
            <xs:annotation/>
         </xs:element>
         <xs:element name="bindingInstruction"
                     minOccurs="0"
                     maxOccurs="1"
                     type="m:YesNo"
                     sawsdl:modelReference="http://iec.ch/TC57/CIM100#Instructions.bindingInstruction">
            <xs:annotation/>
         </xs:element>
         <xs:element name="instructionStartTime"
                     minOccurs="0"
                     maxOccurs="1"
                     type="xs:dateTime"
                     sawsdl:modelReference="http://iec.ch/TC57/CIM100#Instructions.instructionStartTime">
            <xs:annotation>
               <xs:documentation>Time the resource should be at Pmin (for start ups).</xs:documentation>
               <xs:documentation>Time the resource is off line.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="instructionType"
                     minOccurs="0"
                     maxOccurs="1"
                     type="m:AutomaticDispInstTypeCommitment"
                     sawsdl:modelReference="http://iec.ch/TC57/CIM100#Instructions.instructionType">
            <xs:annotation>
               <xs:documentation>Indicator of either a Start-Up or a Shut-Down.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="InstructionClearing"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="m:InstructionClearing"
                     sawsdl:modelReference="http://iec.ch/TC57/CIM100#Instructions.InstructionClearing">
            <xs:annotation/>
         </xs:element>
         <xs:element name="RegisteredResource"
                     minOccurs="0"
                     maxOccurs="1"
                     type="m:RegisteredResource"
                     sawsdl:modelReference="http://iec.ch/TC57/CIM100#Instructions.RegisteredResource">
            <xs:annotation/>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="Market" sawsdl:modelReference="http://iec.ch/TC57/CIM100#Market">
      <xs:annotation>
         <xs:documentation>Market (e.g. Day Ahead Market, Real Time Market) with a description of the Market operation control parameters.</xs:documentation>
      </xs:annotation>
      <xs:complexContent>
         <xs:extension base="m:IdentifiedObject">
            <xs:sequence>
               <xs:element name="timeIntervalLength"
                           minOccurs="0"
                           maxOccurs="1"
                           type="xs:float"
                           sawsdl:modelReference="http://iec.ch/TC57/CIM100#Market.timeIntervalLength">
                  <xs:annotation>
                     <xs:documentation>Trading time interval length.</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element name="MarketFactors"
                           minOccurs="0"
                           maxOccurs="unbounded"
                           type="m:MarketFactors"
                           sawsdl:modelReference="http://iec.ch/TC57/CIM100#Market.MarketFactors">
                  <xs:annotation/>
               </xs:element>
            </xs:sequence>
         </xs:extension>
      </xs:complexContent>
   </xs:complexType>
   <xs:complexType name="MarketActualEvent"
                   sawsdl:modelReference="http://iec.ch/TC57/CIM100#MarketActualEvent">
      <xs:annotation>
         <xs:documentation>This class represents the actual instance of an event.</xs:documentation>
      </xs:annotation>
      <xs:complexContent>
         <xs:extension base="m:IdentifiedObject">
            <xs:sequence>
               <xs:element name="eventComments"
                           minOccurs="0"
                           maxOccurs="1"
                           type="xs:string"
                           sawsdl:modelReference="http://iec.ch/TC57/CIM100#MarketActualEvent.eventComments">
                  <xs:annotation>
                     <xs:documentation>Free format comments for the event, for any purpose needed.</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element name="eventEndTime"
                           minOccurs="0"
                           maxOccurs="1"
                           type="xs:dateTime"
                           sawsdl:modelReference="http://iec.ch/TC57/CIM100#MarketActualEvent.eventEndTime">
                  <xs:annotation>
                     <xs:documentation>End time of the event.</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element name="eventStartTime"
                           minOccurs="0"
                           maxOccurs="1"
                           type="xs:dateTime"
                           sawsdl:modelReference="http://iec.ch/TC57/CIM100#MarketActualEvent.eventStartTime">
                  <xs:annotation>
                     <xs:documentation>Start time of the event.</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element name="eventStatus"
                           minOccurs="0"
                           maxOccurs="1"
                           type="m:MarketEventStatusKind"
                           sawsdl:modelReference="http://iec.ch/TC57/CIM100#MarketActualEvent.eventStatus">
                  <xs:annotation>
                     <xs:documentation>Event status, e.g. active, canceled, expired, etc.</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element name="eventType"
                           minOccurs="0"
                           maxOccurs="1"
                           type="xs:string"
                           sawsdl:modelReference="http://iec.ch/TC57/CIM100#MarketActualEvent.eventType">
                  <xs:annotation>
                     <xs:documentation>Actual event type.</xs:documentation>
                  </xs:annotation>
               </xs:element>
            </xs:sequence>
         </xs:extension>
      </xs:complexContent>
   </xs:complexType>
   <xs:simpleType name="MarketEventStatusKind"
                  sawsdl:modelReference="http://iec.ch/TC57/CIM100#MarketEventStatusKind">
      <xs:annotation>
         <xs:documentation>Market event status types.</xs:documentation>
      </xs:annotation>
      <xs:restriction base="xs:string">
         <xs:enumeration value="active">
            <xs:annotation>
               <xs:documentation>The status of the event is currently in a active state.</xs:documentation>
               <xs:documentation>Active (when sysdate is equal or greater than to planned start time)</xs:documentation>
            </xs:annotation>
         </xs:enumeration>
         <xs:enumeration value="cancelled">
            <xs:annotation>
               <xs:documentation>The status of the event is currently in a cancelled state.</xs:documentation>
               <xs:documentation>Cancelled (stopped before planned start time or planned end time)</xs:documentation>
            </xs:annotation>
         </xs:enumeration>
         <xs:enumeration value="completed">
            <xs:annotation>
               <xs:documentation>The status of the event is currently in a completed state.</xs:documentation>
               <xs:documentation>Complete (when sysdate is equal to the release time)</xs:documentation>
            </xs:annotation>
         </xs:enumeration>
         <xs:enumeration value="planned">
            <xs:annotation>
               <xs:documentation>The status of the event is currently in a planned state.</xs:documentation>
               <xs:documentation>Planned (sysdate is less than planned start time)</xs:documentation>
            </xs:annotation>
         </xs:enumeration>
      </xs:restriction>
   </xs:simpleType>
   <xs:complexType name="MarketFactors"
                   sawsdl:modelReference="http://iec.ch/TC57/CIM100#MarketFactors">
      <xs:annotation>
         <xs:documentation>Aggregation of market information relative for a specific time interval.</xs:documentation>
      </xs:annotation>
      <xs:complexContent>
         <xs:extension base="m:Document">
            <xs:sequence>
               <xs:element name="intervalEndTime"
                           minOccurs="0"
                           maxOccurs="1"
                           type="xs:dateTime"
                           sawsdl:modelReference="http://iec.ch/TC57/CIM100#MarketFactors.intervalEndTime">
                  <xs:annotation>
                     <xs:documentation>The end of the time interval for which requirement is defined.</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element name="intervalStartTime"
                           minOccurs="0"
                           maxOccurs="1"
                           type="xs:dateTime"
                           sawsdl:modelReference="http://iec.ch/TC57/CIM100#MarketFactors.intervalStartTime">
                  <xs:annotation>
                     <xs:documentation>The start of the time interval for which requirement is defined.</xs:documentation>
                  </xs:annotation>
               </xs:element>
            </xs:sequence>
         </xs:extension>
      </xs:complexContent>
   </xs:complexType>
   <xs:complexType name="MarketProduct"
                   sawsdl:modelReference="http://iec.ch/TC57/CIM100#MarketProduct">
      <xs:annotation>
         <xs:documentation>A product traded by an RTO (e.g. energy, 10 minute spinning reserve).  Ancillary service product examples include: Regulation, Regulation Up, Regulation Down, Spinning Reserve, Non-Spinning Reserve, etc.</xs:documentation>
      </xs:annotation>
      <xs:complexContent>
         <xs:extension base="m:IdentifiedObject">
            <xs:sequence>
               <xs:element name="marketProductType"
                           minOccurs="0"
                           maxOccurs="1"
                           type="m:MarketProductType"
                           sawsdl:modelReference="http://iec.ch/TC57/CIM100#MarketProduct.marketProductType">
                  <xs:annotation>
                     <xs:documentation>Market product type examples:</xs:documentation>
                     <xs:documentation>EN (Energy)</xs:documentation>
                     <xs:documentation>RU (Regulation Up)</xs:documentation>
                     <xs:documentation>RD (Regulation Dn)</xs:documentation>
                     <xs:documentation>SR (Spinning Reserve)</xs:documentation>
                     <xs:documentation>NR (Non-Spinning Reserve)</xs:documentation>
                     <xs:documentation>RC (RUC)</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element name="Market"
                           minOccurs="0"
                           maxOccurs="1"
                           type="m:Market"
                           sawsdl:modelReference="http://iec.ch/TC57/CIM100#MarketProduct.Market">
                  <xs:annotation/>
               </xs:element>
            </xs:sequence>
         </xs:extension>
      </xs:complexContent>
   </xs:complexType>
   <xs:simpleType name="MarketProductType"
                  sawsdl:modelReference="http://iec.ch/TC57/CIM100#MarketProductType">
      <xs:annotation>
         <xs:documentation>For example:</xs:documentation>
         <xs:documentation>Energy, Reg Up, Reg Down, Spin Reserve, Nonspin Reserve, RUC, Load Folloing Up, and Load Following Down.</xs:documentation>
      </xs:annotation>
      <xs:restriction base="xs:string">
         <xs:enumeration value="EN">
            <xs:annotation>
               <xs:documentation>energy type</xs:documentation>
            </xs:annotation>
         </xs:enumeration>
         <xs:enumeration value="LFD">
            <xs:annotation>
               <xs:documentation>Load following down</xs:documentation>
            </xs:annotation>
         </xs:enumeration>
         <xs:enumeration value="LFU">
            <xs:annotation>
               <xs:documentation>Load following up</xs:documentation>
            </xs:annotation>
         </xs:enumeration>
         <xs:enumeration value="NR">
            <xs:annotation>
               <xs:documentation>non spinning reserve</xs:documentation>
            </xs:annotation>
         </xs:enumeration>
         <xs:enumeration value="RC">
            <xs:annotation>
               <xs:documentation>Residual Unit Commitment</xs:documentation>
            </xs:annotation>
         </xs:enumeration>
         <xs:enumeration value="RD">
            <xs:annotation>
               <xs:documentation>regulation down</xs:documentation>
            </xs:annotation>
         </xs:enumeration>
         <xs:enumeration value="REG">
            <xs:annotation>
               <xs:documentation>Regulation</xs:documentation>
            </xs:annotation>
         </xs:enumeration>
         <xs:enumeration value="RU">
            <xs:annotation>
               <xs:documentation>regulation up</xs:documentation>
            </xs:annotation>
         </xs:enumeration>
         <xs:enumeration value="SR">
            <xs:annotation>
               <xs:documentation>spinning reserve</xs:documentation>
            </xs:annotation>
         </xs:enumeration>
      </xs:restriction>
   </xs:simpleType>
   <xs:complexType name="MarketRun"
                   sawsdl:modelReference="http://iec.ch/TC57/CIM100#MarketRun">
      <xs:annotation>
         <xs:documentation>This class represents an actual instance of a planned market. For example, a Day Ahead market opens with the Bid Submission, ends with the closing of the Bid Submission. The market run represent the whole process. MarketRuns can be defined for markets such as Day Ahead Market, Real Time Market, Hour Ahead Market, Week Ahead Market, etc.</xs:documentation>
      </xs:annotation>
      <xs:complexContent>
         <xs:extension base="m:IdentifiedObject">
            <xs:sequence>
               <xs:element name="marketEndTime"
                           minOccurs="0"
                           maxOccurs="1"
                           type="xs:dateTime"
                           sawsdl:modelReference="http://iec.ch/TC57/CIM100#MarketRun.marketEndTime">
                  <xs:annotation>
                     <xs:documentation>The end time defined as the end of the market, market end time.</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element name="marketStartTime"
                           minOccurs="0"
                           maxOccurs="1"
                           type="xs:dateTime"
                           sawsdl:modelReference="http://iec.ch/TC57/CIM100#MarketRun.marketStartTime">
                  <xs:annotation>
                     <xs:documentation>The start time defined as the beginning of the market, market start time.</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element name="marketType"
                           minOccurs="0"
                           maxOccurs="1"
                           type="m:MarketType"
                           sawsdl:modelReference="http://iec.ch/TC57/CIM100#MarketRun.marketType">
                  <xs:annotation>
                     <xs:documentation>The market type, Day Ahead Market or Real Time Market.</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element name="Market"
                           minOccurs="0"
                           maxOccurs="1"
                           type="m:Market"
                           sawsdl:modelReference="http://iec.ch/TC57/CIM100#MarketRun.Market">
                  <xs:annotation/>
               </xs:element>
            </xs:sequence>
         </xs:extension>
      </xs:complexContent>
   </xs:complexType>
   <xs:simpleType name="MarketType"
                  sawsdl:modelReference="http://iec.ch/TC57/CIM100#MarketType">
      <xs:annotation>
         <xs:documentation>Market type.</xs:documentation>
      </xs:annotation>
      <xs:restriction base="xs:string">
         <xs:enumeration value="DAM">
            <xs:annotation>
               <xs:documentation>Day ahead market.</xs:documentation>
            </xs:annotation>
         </xs:enumeration>
         <xs:enumeration value="HAM">
            <xs:annotation>
               <xs:documentation>Hour Ahead Market.</xs:documentation>
            </xs:annotation>
         </xs:enumeration>
         <xs:enumeration value="RTM">
            <xs:annotation>
               <xs:documentation>Real time market.</xs:documentation>
            </xs:annotation>
         </xs:enumeration>
         <xs:enumeration value="RUC">
            <xs:annotation>
               <xs:documentation>Residual Unit Commitment.</xs:documentation>
            </xs:annotation>
         </xs:enumeration>
      </xs:restriction>
   </xs:simpleType>
   <xs:complexType name="RegisteredDistributedResource"
                   sawsdl:modelReference="http://iec.ch/TC57/CIM100#RegisteredDistributedResource">
      <xs:annotation>
         <xs:documentation>A registered resource that represents a distributed energy resource, such as a micro-generator, fuel cell, photo-voltaic energy source, etc.</xs:documentation>
      </xs:annotation>
      <xs:complexContent>
         <xs:extension base="m:RegisteredResource">
            <xs:sequence/>
         </xs:extension>
      </xs:complexContent>
   </xs:complexType>

<xs:complexType name="SetPoint">
   <xs:annotation>
      <xs:documentation>A single set point with name, unit and value.</xs:documentation>
   </xs:annotation>
   <xs:complexContent>
      <xs:extension base="m:IdentifiedObject">
         <xs:sequence>
            <xs:element name="name"
                        minOccurs="0"
                        maxOccurs="1"
                        type="xs:string"/>
            
            <xs:element name="unit"
                        minOccurs="0"
                        maxOccurs="1"
                        type="xs:string"/>
            
            <xs:element name="value"
                        minOccurs="0"
                        maxOccurs="1"
                        type="xs:float"/>
         </xs:sequence>
      </xs:extension>
   </xs:complexContent>
</xs:complexType>


<xs:complexType name="AvailableSetPoints">
   <xs:annotation>
      <xs:documentation>Container grouping multiple set points.</xs:documentation>
   </xs:annotation>
   <xs:complexContent>
      <xs:extension base="m:IdentifiedObject">
         <xs:sequence>
            <xs:element name="SetPoint"
                        minOccurs="0"
                        maxOccurs="unbounded"
                        type="m:SetPoint"/>
         </xs:sequence>
      </xs:extension>
   </xs:complexContent>
</xs:complexType>

<xs:complexType name="RegisteredResource"
                sawsdl:modelReference="http://iec.ch/TC57/CIM100#RegisteredResource">
   <xs:annotation>
      <xs:documentation>A resource that is registered through the market participant registration system.</xs:documentation>
   </xs:annotation>
   <xs:sequence>
      <xs:element name="AvailableSetPoints"
                  minOccurs="0"
                  maxOccurs="1"
                  type="m:AvailableSetPoints">
         <xs:annotation>
            <xs:documentation>Set of available set points for this resource.</xs:documentation>
         </xs:annotation>
      </xs:element>
   </xs:sequence>
</xs:complexType>
   <xs:simpleType name="YesNo" sawsdl:modelReference="http://iec.ch/TC57/CIM100#YesNo">
      <xs:annotation>
         <xs:documentation>Used as a flag set to Yes or No.</xs:documentation>
      </xs:annotation>
      <xs:restriction base="xs:string">
         <xs:enumeration value="NO">
            <xs:annotation/>
         </xs:enumeration>
         <xs:enumeration value="YES">
            <xs:annotation/>
         </xs:enumeration>
      </xs:restriction>
   </xs:simpleType>
</xs:schema>
